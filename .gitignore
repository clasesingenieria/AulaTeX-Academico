# Entrenamiento: Git conserva código/configuración/manifiestos, no datos ni pesos.
.ipynb_checkpoints/
**/.ipynb_checkpoints/
data/private/*
!data/private/.gitkeep
models/local/
checkpoints/
artifacts/
outputs/
runs/
wandb/
tensorboard/
hf_cache/
.cache/huggingface/
*.safetensors
*.pt
*.pth
*.ckpt
adapter_model.*
trainer_state.json
optimizer.pt
scheduler.pt

# .venv: versionar la carpeta pero ignorar su contenido (ver .venv/.gitignore),
# excepto el script de reconstruccion install-venv.ps1
.venv/*
!.venv/.gitignore
!.venv/install-venv.ps1
.venv-linux/
# Entornos virtuales anidados en carpetas institucionales: siempre locales.
*/**/.venv/
logs-compilacion-tex/
*.xlsx
*_temp.tex
TODO.txt
scripts/preview/
scripts/tikz-preview/
# scripts/aulatex.env se versiona con secretos cifrados (enc:); la clave secret.key permanece ignorada.

# Incubadora local: conservar carpeta, ignorar contenido
upgrade/*
!upgrade/.gitkeep

# VS Code: compartir recetas del proyecto, no estado local del editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
bot-interfaz/.venv/
bot-interfaz/.pytest_cache/
bot-interfaz/**/__pycache__/
bot-interfaz/**/*.pyc
bot-interfaz/interfaz.env

# Clave de cifrado local de secretos: NUNCA versionar
secret.key
**/secret.key
scripts/secret.key

# Bóveda institucional y copias accidentales: nunca versionar, ni cifradas.
**/platform-credentials.vault.json*

# Respaldos automaticos del .env: pueden contener secretos en claro
scripts/aulatex.env.bak-*
**/*.env.bak-*
