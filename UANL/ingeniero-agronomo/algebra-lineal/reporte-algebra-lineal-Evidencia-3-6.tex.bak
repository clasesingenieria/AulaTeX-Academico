\node (dec) [decision, below of=det, yshift=-0.5cm] {¿$\det(A) \neq 0$?};
\node (err) [process, right of=dec, xshift=3.5cm] {Sistema singular (sin solución o múltiple)};
\node (choice) [process, below of=dec, yshift=-0.7cm] {Seleccionar método: Gauss-Jordan / Cramer / Inversa};

\node (gj) [process, below of=choice, xshift=-4cm, yshift=-0.5cm] {Gauss-Jordan:\\ Forma RREF $[I_3 \mid \mathbf{u}]$};
\node (cra) [process, below of=choice, yshift=-0.5cm] {Cramer:\\ $\det(A_i)/\det(A)$};
\node (inv) [process, below of=choice, xshift=4cm, yshift=-0.5cm] {Matriz Inversa:\\ $\mathbf{u} = A^{-1}\mathbf{b}$};

\node (sol) [process, below of=cra, yshift=-1.2cm] {Obtener solución exacta: $\mathbf{u}^* = \left(-\frac{103}{335}, -\frac{74}{335}, -\frac{379}{335}\right)^T$};
\node (ver) [process, below of=sol] {Comprobar residuo: $A\mathbf{u}^* - \mathbf{b} = \mathbf{0}$};
\node (stop) [startstop, below of=ver] {Fin};

\draw [arrow] (start) -- (in);
\draw [arrow] (in) -- (det);
\draw [arrow] (det) -- (dec);
\draw [arrow] (dec) -- node[above, font=\footnotesize] {No} (err);
\draw [arrow] (dec) -- node[right, font=\footnotesize] {Sí ($\det=-670$)} (choice);
\draw [arrow] (choice) -| (gj);
\draw [arrow] (choice) -- (cra);
\draw [arrow] (choice) -| (inv);
\draw [arrow] (gj) |- (sol);
