\hline
A (12-24-12) & 200 & 24 & 48 & 24 \\
B (20-10-10) & 300 & 60 & 30 & 30 \\
C (15-05-30) & 100 & 15 & 5 & 30 \\
\hline
Total & 600 & 99 & 83 & 84 \\
\hline
\end{tabular}
\end{table}

