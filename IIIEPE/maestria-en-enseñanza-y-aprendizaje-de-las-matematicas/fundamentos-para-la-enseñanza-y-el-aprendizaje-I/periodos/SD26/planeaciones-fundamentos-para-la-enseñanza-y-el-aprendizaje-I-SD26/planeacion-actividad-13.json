  "curriculum": {
    "purpose": "Analizar las cuatro sugerencias metodológicas sociocríticas de la Secretaría de Educación Pública (2022b) —Proyectos Comunitarios, Indagación STEAM, Aprendizaje Basado en Problemas (ABP) y Aprendizaje Servicio (AS)— distinguiendo sus fases, palabras clave, forma de trabajo, roles y pertinencia matemática.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Distingue rigurosamente el Aprendizaje Basado en Proyectos Comunitarios del Aprendizaje Basado en Problemas, evitando ambigüedades terminológicas."
      },
      {
        "id": "comp-2",
        "text": "Selecciona y adapta la metodología sociocrítica pertinente al objeto matemático y problema formativo."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Presenta cuadro comparativo completo de cuatro entradas y matriz de roles docentes y estudiantiles con transferencia a proyectos de matemáticas."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Sugerencias metodológicas para el desarrollo de proyectos educativos (SEP, 2022b)",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Criterios de selección metodológica en Saberes y Pensamiento Científico",
        "children": []
      }
    ]
  },
