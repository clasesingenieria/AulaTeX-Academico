  "curriculum": {
    "purpose": "Generar una reflexión diagnóstica inicial sobre enseñanza, aprendizaje, paradigmas y matemáticas, y analizar cuatro ideas relevantes de Cynthia Luna Scott (2015) sobre la transformación educativa en el siglo XXI.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Analiza críticamente sus concepciones previas sobre enseñanza, aprendizaje, paradigmas educativos y matemáticas desde su trayectoria docente."
      },
      {
        "id": "comp-2",
        "text": "Argumenta las fuerzas que impulsan la reforma del currículo y los métodos pedagógicos en el siglo XXI con sustento en documentos de la UNESCO."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Formula cuatro ideas clave comentadas de Scott (2015) y un diagnóstico conceptual articulado con ejemplos de docencia técnica y matemáticas."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "El futuro del aprendizaje en el siglo XXI (Scott, 2015)",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Diagnóstico conceptual: enseñanza, aprendizaje, paradigmas y matemáticas",
        "children": []
      }
    ]
  },
