      "instruction": "A partir de 'El Modelo Bioecológico del Desarrollo Humano' de Bronfenbrenner y Morris, responder argumentadamente las seis preguntas oficiales relacionando procesos proximales, crítica al individualismo y factores de micro, meso, exo y macrosistema.",
      "requirements": [
        {
          "id": "req-1",
          "text": "Responder con profundidad y fundamentación las 6 preguntas oficiales de Actividad El Modelo Bioecologico.docx."
        },
        {
          "id": "req-2",
          "text": "Analizar procesos proximales destacando regularidad, reciprocidad, complejidad progresiva e interacción con objetos y símbolos matemáticos."
        },
        {
          "id": "req-3",
          "text": "Incluir diagrama elíptico TikZ de los sistemas ecológicos y matriz contextual propia con citas APA 7."
        }
      ],
      "questions": [
        {
          "id": "q-1",
          "context": "Modelo PPCT",
          "text": "¿Cómo explica el modelo PPCT el aprendizaje y cómo cuestiona la visión exclusivamente individualista?",
          "requirement_ids": [
            "req-1"
          ]
        },
        {
          "id": "q-2",
          "context": "Procesos y sistemas",
          "text": "¿Qué interacciones docentes constituyen procesos proximales efectivos y qué factores de cada sistema influyen en mi contexto?",
          "requirement_ids": [
            "req-1"
          ]
        }
      ],
