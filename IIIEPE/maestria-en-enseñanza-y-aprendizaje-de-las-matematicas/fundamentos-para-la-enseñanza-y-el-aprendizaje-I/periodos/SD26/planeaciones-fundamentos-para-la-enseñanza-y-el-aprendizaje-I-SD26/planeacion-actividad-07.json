  "curriculum": {
    "purpose": "Analizar el Modelo Bioecológico Proceso–Persona–Contexto–Tiempo (PPCT) de Bronfenbrenner y Morris y examinar cómo los procesos proximales y los sistemas contextuales configuran el aprendizaje de las matemáticas.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Explica la interacción dinámica Proceso–Persona–Contexto–Tiempo cuestionando explicaciones individualistas del desempeño escolar."
      },
      {
        "id": "comp-2",
        "text": "Identifica condiciones de regularidad, reciprocidad y complejidad progresiva en las interacciones docentes-estudiantes y los cuatro sistemas ecológicos."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Responde con rigor las seis preguntas oficiales sobre el modelo bioecológico, representa los sistemas en TikZ y propone mejoras situadas."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Modelo Bioecológico PPCT y procesos proximales (Bronfenbrenner y Morris, 2006)",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Microsistema, mesosistema, exosistema, macrosistema y cronosistema en educación matemática",
        "children": []
      }
    ]
  },
