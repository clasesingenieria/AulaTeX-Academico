  "curriculum": {
    "purpose": "Analizar visual y conceptualmente el capítulo 'Mejorando el aprendizaje: las implicaciones de las investigaciones en las ciencias del aprendizaje' de R. Keith Sawyer (2008), contrastando el modelo escolar tradicional (instruccionismo) frente a los principios de comprensión profunda, andamiaje, articulación, metacognición y conocimiento distribuido en matemáticas.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Contrasta el modelo estándar de transmisión-adquisición con los hallazgos interdisciplinarios de las ciencias del aprendizaje."
      },
      {
        "id": "comp-2",
        "text": "Sintetiza mediante infografía estructurada los principios cognitivos y sociales del aprendizaje profundo aplicados al aula matemática."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Produce infografía vectorial monográfica dedicada a Sawyer (2008) en LaTeX/PDF, reporte analítico y presentación Beamer."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Instruccionismo de la era industrial vs. economía del conocimiento (Sawyer, 2008)",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Andamiaje (scaffolding), articulación y metacognición en la enseñanza de las matemáticas",
        "children": []
      }
    ]
  },
