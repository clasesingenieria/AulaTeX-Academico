  "curriculum": {
    "purpose": "Analizar críticamente el enfoque de aprendizaje profundo a partir de Quiroga Aguilar y Lara Órdenes (2022) y Sawyer (2008), diferenciándolo del aprendizaje superficial y articulando sus dominios cognitivo, interpersonal e intrapersonal en matemáticas.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Contrasta con rigor epistémico el aprendizaje superficial memorístico frente al aprendizaje profundo comprensivo y transferible."
      },
      {
        "id": "comp-2",
        "text": "Articula las dimensiones cognitiva, interpersonal e intrapersonal para transformar las creencias y prácticas docentes."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Responde argumentadamente las cinco preguntas oficiales integrando ejemplos matemáticos y la perspectiva de las nuevas pedagogías."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Aprendizaje superficial vs. aprendizaje profundo (Marton y Säljö, 1976; Quiroga y Lara, 2022)",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Dominios cognitivo, interpersonal e intrapersonal en la enseñanza matemática",
        "children": []
      }
    ]
  },
