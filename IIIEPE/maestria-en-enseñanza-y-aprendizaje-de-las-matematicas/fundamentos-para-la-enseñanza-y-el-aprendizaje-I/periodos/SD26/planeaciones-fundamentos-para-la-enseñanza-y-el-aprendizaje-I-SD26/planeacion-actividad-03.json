  "curriculum": {
    "purpose": "Diseñar una infografía académica y análisis crítico que conecten los planteamientos de Keith Sawyer (2008) y Philippe Meirieu (2020) sobre la transición de la pedagogía transmisiva hacia el aprendizaje profundo y la construcción de lo común.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Sintetiza e interrelaciona las aportaciones de las ciencias del aprendizaje (Sawyer) y la pedagogía cooperativa (Meirieu)."
      },
      {
        "id": "comp-2",
        "text": "Comunica visualmente marcos teóricos complejos cumpliendo criterios de diseño infográfico y rigor conceptual."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Produce una infografía vectorial en TikZ y su análisis aplicado a la enseñanza de las matemáticas conforme a la Rúbrica 3."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Ciencias del aprendizaje y cinco condiciones para el aprendizaje profundo (Sawyer, 2008)",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Pedagogía de lo común y lo singular, relación pedagógica y uso crítico de tecnologías (Meirieu, 2020)",
        "children": []
      }
    ]
  },
