  "curriculum": {
    "purpose": "Fortalecer, en Temas Selectos de Matemáticas I de la Maestría en Enseñanza y Aprendizaje de las Matemáticas del IIIEPE, la capacidad de diseñar y justificar una intervención didáctica sobre suma y resta de fracciones, articulando significado de las operaciones, representaciones, análisis de errores, contenido curricular y evaluación formativa.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Analizar la suma y resta de fracciones mediante equivalencia, unidad de referencia y representaciones que fundamenten los procedimientos."
      },
      {
        "id": "comp-2",
        "text": "Diseñar una secuencia didáctica coherente con el contenido y el Proceso de Desarrollo de Aprendizaje (PDA) asignados, una vez confirmados."
      },
      {
        "id": "comp-3",
        "text": "Anticipar estrategias y errores del alumnado y formular intervenciones docentes sustentadas en evidencias observables."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Explica por qué es necesario expresar las fracciones en unidades compatibles para sumarlas o restarlas, distinguiendo denominador común de mínimo común denominador."
      },
      {
        "id": "out-2",
        "text": "Resuelve y justifica ejemplos de suma y resta con denominadores iguales y diferentes, verificando la coherencia de sus representaciones y resultados."
      },
      {
        "id": "out-3",
        "text": "Construye una matriz que relaciona contenido, PDA confirmado, actividades, evidencias y criterios de evaluación; identifica explícitamente cualquier dato pendiente."
      },
      {
        "id": "out-4",
        "text": "Elabora una ficha de trabajo con progresión didáctica, soluciones comentadas, errores anticipados y decisiones de retroalimentación."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Unidad de referencia, significado de fracción y equivalencia.",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Suma y resta con denominadores iguales y diferentes.",
        "children": []
      },
      {
        "id": "top-3",
        "text": "Denominadores comunes y papel del mínimo común múltiplo.",
        "children": []
      },
      {
        "id": "top-4",
        "text": "Representaciones gráficas, recta numérica y escritura simbólica.",
        "children": []
      },
      {
        "id": "top-5",
        "text": "Errores frecuentes y obstáculos en la comprensión de las operaciones.",
        "children": []
      }
    ]
  },
