  "curriculum": {
    "purpose": "Deducir propiedades angulares de triángulos, polígonos regulares inscritos y circunferencias, demostrando la relación entre ángulo central e inscrito mediante GeoGebra.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Generaliza la suma de ángulos interiores (n-2)·180° y las medidas centrales e interiores de polígonos regulares inscritos."
      },
      {
        "id": "comp-2",
        "text": "Formula y demuestra la invariancia del ángulo inscrito respecto al ángulo central sobre el mismo arco."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Completa las tablas de triangulación y polígonos inscritos, ejecuta la exploración dinámica en GeoGebra y justifica el teorema ∠ACB = ½∠AOB."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Triangulación de polígonos y ángulo central 360°/n",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Teorema del ángulo central e inscrito y paso al límite hacia la circunferencia",
        "children": []
      }
    ]
  },
