        "verb": "Generalizar",
        "object": "relaciones angulares en polígonos regulares y en la circunferencia",
        "conditions": "combinando triangulación por diagonales y manipulación dinámica de puntos A, B y C en GeoGebra Classic",
        "observable_evidence": "Guión 3 Word con capturas GeoGebra, reporte LaTeX con demostración formal, presentación Beamer y ficha",
        "justification": "Transita de la experimentación concreta (recorte y GeoGebra) a la generalización algebraica y prueba deductiva."
      },
      "instruction": "Desarrollar las actividades de suma de ángulos en triángulos y polígonos, explorar en GeoGebra el ángulo central e inscrito anexando capturas y contestar las preguntas de descubrimiento y reflexión.",
      "requirements": [
        {
          "id": "req-1",
          "text": "Completar las tablas de triangulación (n=3..10 y n=20) y polígonos regulares inscritos (n=6..24)."
        },
        {
          "id": "req-2",
          "text": "Realizar la construcción en GeoGebra de ∠AOB y ∠ACB variando C, A y B con capturas de evidencia."
        },
        {
          "id": "req-3",
          "text": "Justificar matemáticamente ∠ACB = ½∠AOB y analizar ventajas y limitaciones didácticas de GeoGebra."
        }
      ],
      "questions": [
        {
          "id": "q-1",
          "context": "GeoGebra c",
          "text": "¿Cómo se demuestra que el ángulo inscrito mide exactamente la mitad del ángulo central que subtiende el mismo arco?",
          "requirement_ids": [
            "req-1"
          ]
        },
        {
          "id": "q-2",
          "context": "Reflexión docente",
          "text": "¿Qué ventajas y limitaciones presenta GeoGebra frente a la construcción manual y la prueba matemática?",
          "requirement_ids": [
            "req-1"
          ]
        }
