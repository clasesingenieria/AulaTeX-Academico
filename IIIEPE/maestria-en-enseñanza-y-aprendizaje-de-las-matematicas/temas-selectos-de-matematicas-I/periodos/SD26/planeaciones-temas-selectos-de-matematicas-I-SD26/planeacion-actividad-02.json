        "taxonomy": "Bloom",
        "level": "analisis",
        "verb": "Analizar",
        "object": "las propiedades invariantes y la ubicación relativa del circuncentro (O) y del incentro (I)",
        "conditions": "mediante construcciones automatizadas en GeoGebra Classic sobre triángulos acutángulos, rectángulos y obtusángulos",
        "observable_evidence": "Guión 2 Word con 8 capturas GeoGebra, reporte LaTeX, presentación Beamer y ficha del estudiante",
        "justification": "Vincula la visualización dinámica en GeoGebra con la justificación deductiva de equidistancia."
      },
      "instruction": "Resolver los tres retos de equidistancia y ejecutar las actividades a, b, c y d en GeoGebra Classic, anexando capturas, tabla comparativa y reflexiones docentes.",
      "requirements": [
        {
          "id": "req-1",
          "text": "Construir en GeoGebra mediatrices y circuncentro O midiendo OA=OB=OC y explorando triángulos acutángulo, rectángulo y obtusángulo."
        },
        {
          "id": "req-2",
          "text": "Construir bisectrices interiores e incentro I en los tres tipos de triángulos y completar la tabla comparativa O vs. I."
        },
        {
          "id": "req-3",
          "text": "Responder todas las preguntas de reflexión matemática y didáctica en Guión 2 (.docx) y reporte LaTeX."
        }
      ],
      "questions": [
        {
          "id": "q-1",
          "context": "Actividad b y c",
          "text": "¿Por qué el circuncentro O puede ubicarse dentro, sobre la hipotenusa o fuera del triángulo, mientras el incentro I es siempre interior?",
          "requirement_ids": [
            "req-1"
          ]
        },
        {
          "id": "q-2",
          "context": "Reflexión docente",
          "text": "¿En qué momento didáctico conviene formalizar los términos circuncentro e incentro tras la exploración?",
          "requirement_ids": [
            "req-1"
          ]
        }
      ],
