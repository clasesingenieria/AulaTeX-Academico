  "curriculum": {
    "purpose": "Explorar lugares geométricos de equidistancia mediante construcciones con regla, compás y GeoGebra Classic, formalizando mediatrices, bisectrices, circuncentro (O) e incentro (I).",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Construye e interpreta mediatrices, bisectrices, circuncentro e incentro en GeoGebra Classic verificando invariantes métricas."
      },
      {
        "id": "comp-2",
        "text": "Analiza la transición entre exploración empírica y formalización geométrica para el aula de secundaria."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Completa las actividades a, b, c y d de la Guía GeoGebra con capturas verificables, tabla comparativa O vs. I y reflexión pedagógica."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Mediatriz y circuncentro (equidistancia a vértices)",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Bisectriz e incentro (equidistancia a lados del triángulo)",
        "children": []
      }
    ]
  },
