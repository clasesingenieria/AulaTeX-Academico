  "curriculum": {
    "purpose": "Analizar las ocho habilidades matemáticas del enfoque de resolución de problemas (SEP, 1994) en articulación con los procesos matemáticos contemporáneos (Alsina, 2023).",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Distingue capacidades, habilidades y destrezas matemáticas y articula las ocho habilidades SEP con los procesos descritos por Alsina (2023)."
      },
      {
        "id": "comp-2",
        "text": "Selecciona y fundamenta habilidades prioritarias vinculadas con un PDA real de su práctica docente."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Entrega reporte de lectura crítico en Guión 4 Word y LaTeX integrando análisis documental, cinco habilidades prioritarias y transferencia a un PDA."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Ocho habilidades matemáticas SEP (1994, pp. 12–13): calcular, inferir, comunicar, medir, imaginar, estimar, generalizar, deducir",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Conocimientos esenciales sobre procesos y fases de resolución (Alsina, 2023, pp. 71–75)",
        "children": []
      }
    ]
  },
