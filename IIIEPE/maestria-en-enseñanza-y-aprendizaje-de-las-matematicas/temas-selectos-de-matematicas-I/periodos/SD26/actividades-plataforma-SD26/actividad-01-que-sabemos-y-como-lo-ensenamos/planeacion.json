        "verb": "Diseñar",
        "object": "soluciones justificadas a retos de optimización de área/perímetro y una secuencia didáctica colaborativa",
        "conditions": "a partir de la presentación interactiva de 15 diapositivas, la rúbrica oficial y el tablero colaborativo Canva del Equipo 4",
        "observable_evidence": "Reporte LaTeX compilado, presentación Beamer, ficha del estudiante y evidencia del tablero Canva (Equipo 4)",
        "justification": "Integra el dominio disciplinar de la invariancia y optimización área-perímetro con la mediación docente humanista."
      },
      "instruction": "Participar en el diagnóstico inicial, resolver y demostrar los tres retos de la sesión, responder las tres pausas de reflexión pedagógica e integrar la propuesta didáctica del Equipo 4 en Canva.",
      "requirements": [
        {
          "id": "req-1",
          "text": "Resolver con múltiples estrategias y demostración los retos 1, 2 y 3 de las 15 diapositivas interactivas."
        },
        {
          "id": "req-2",
          "text": "Responder las pausas reflexivas sobre dificultades cognitivas, cuestionamiento a la autoridad y complejidad del razonamiento."
        },
        {
          "id": "req-3",
          "text": "Documentar y articular la propuesta didáctica del Equipo 4 en Canva (Grado 5°, Minecraft/Papercraft, PDA 1–3 y ajustes razonables)."
        }
      ],
      "questions": [
        {
          "id": "q-1",
          "context": "Reto 1 y 3",
          "text": "¿Por qué el rectángulo de área máxima con 4 lados cercados es un cuadrado (6×6 m), mientras que con 3 lados junto a una pared es 6×12 m?",
          "requirement_ids": [
            "req-1"
          ]
        },
        {
          "id": "q-2",
          "context": "Reto 2 y Reflexión",
          "text": "¿Cómo guiar a los estudiantes para cuestionar y validar matemáticamente una afirmación de autoridad sin darles la respuesta?",
          "requirement_ids": [
            "req-1"
          ]
        }
