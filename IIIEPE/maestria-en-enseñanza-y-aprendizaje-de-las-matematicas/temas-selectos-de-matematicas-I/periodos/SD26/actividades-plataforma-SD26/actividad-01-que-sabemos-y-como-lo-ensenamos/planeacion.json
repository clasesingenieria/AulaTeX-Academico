  "curriculum": {
    "purpose": "Recuperar saberes previos sobre área y perímetro mediante desafíos de optimización y diseñar una propuesta didáctica colaborativa en Canva (Equipo 4) centrada en el razonamiento y la argumentación matemática.",
    "competencies": [
      {
        "id": "comp-1",
        "text": "Resuelve problemas de optimización geométrica elemental de área y perímetro explorando casos discretos y justificando algebraicamente."
      },
      {
        "id": "comp-2",
        "text": "Diseña propuestas didácticas situadas con anticipación de dificultades, ajustes razonables y preguntas orientadoras sin dar respuestas directas."
      }
    ],
    "outcomes": [
      {
        "id": "out-1",
        "text": "Resuelve y justifica los tres retos de optimización de área y perímetro (Sesión 8) y consolida la propuesta didáctica del Equipo 4 en Canva."
      }
    ],
    "topics": [
      {
        "id": "top-1",
        "text": "Área y perímetro de rectángulos bajo restricciones de contorno fijo",
        "children": []
      },
      {
        "id": "top-2",
        "text": "Diseño didáctico para el aprendizaje mediante el desafío (Equipo 4 · 5° Primaria)",
        "children": []
      }
    ]
  },
