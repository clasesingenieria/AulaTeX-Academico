# Plantilla de entorno para AulaTeX.
# Copia este archivo a aulaTEX/aulatex.env y completa los valores locales.
# Solo se versionan secretos cifrados (enc:); la clave local secret.key esta ignorada.
# Las API keys pueden guardarse en claro o cifradas con prefijo "enc:" mediante la interfaz de credenciales.

# Opcion experimental de GPT Realtime para una futura integracion interactiva.
# No la usa el pipeline actual de narracion offline y no debe sobrescribir OPENAI_BASE_URL / OPENAI_API_KEY.
# Requiere implementacion aparte por WebSocket/streaming.
AZURE_OPENAI_REALTIME_ENDPOINT=
AZURE_OPENAI_REALTIME_DEPLOYMENT_NAME=gpt-realtime-2.1
AZURE_OPENAI_REALTIME_API_KEY=
AZURE_OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AZURE_OPENAI_REALTIME_VOICE=alloy

# Azure Sora:
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=sora-2
AZURE_OPENAI_AUDIO_MODEL=gpt-4o-mini-tts

AZURE_ENV_NAME=""
AZURE_LOCATION="swedencentral"
AZURE_SUBSCRIPTION_ID=""
AZURE_EXISTING_AIPROJECT_ENDPOINT=""
AZURE_EXISTING_AIPROJECT_RESOURCE_ID=""
AZURE_EXISTING_RESOURCE_ID=""
AZD_ALLOW_NON_EMPTY_FOLDER=true

# Configuracion para la traduccion de libros y generacion de audio

AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Glosario opcional
# TB_BOOKS_TERMINOLOGY_FILE=terminology/glossary.json

# Robustez / rendimiento
TB_BOOKS_TRANSLATION_WORKERS=12
TB_BOOKS_TRANSLATOR_MAX_RETRIES=6
TB_BOOKS_TRANSLATOR_BACKOFF=1
TB_BOOKS_TRANSLATOR_MAX_BACKOFF=30
TB_BOOKS_TRANSLATOR_TIMEOUT=90

# Amazon Polly / audio M4A
TTS_PROVIDER=polly

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
POLLY_VOICE_ID=Andres
POLLY_ENGINE=generative
POLLY_LANGUAGE_CODE=es-MX
POLLY_SAMPLE_RATE=24000
VOICE_RATE=114%
VOICE_VOLUME=+1.14dB
MAX_CHARS=2500
POLLY_WORKERS=12
POLLY_MAX_TPS=6
POLLY_MAX_RETRIES=6
POLLY_RETRY_BASE_DELAY=1
POLLY_RETRY_MAX_DELAY=30
OUTPUT_BITRATE=128k
FFMPEG_PARALLEL_JOBS=4
FFMPEG_GROUP_SIZE=512

# Azure Speech / audio M4A (usado si TTS_PROVIDER=azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=es-MX
AZURE_SPEECH_VOICE=es-MX-JorgeNeural
AZURE_SPEECH_STYLE=chat
AZURE_SPEECH_STYLE_DEGREE=0.9
AZURE_SPEECH_RATE=1.10
AZURE_SPEECH_PITCH=-1
AZURE_SPEECH_VOLUME=110

# FFMPEG_PATH=D:\ruta\a\ffmpeg.exe

# Motor LLM para semantic-safe, validacion y pruebas
TB_BOOKS_LLM_REVIEW_ENGINE="Codex"
TB_BOOKS_LLM_VALIDATION_ENABLED=1
TB_BOOKS_LLM_VALIDATION_TIMEOUT=45
TB_BOOKS_LLM_VALIDATION_MAX_TOKENS=220
TB_BOOKS_LLM_VALIDATION_TEMPERATURE=0
AULATEX_LLM_MAX_TOKENS=32768

# Fuerza todo el motor, auditorias, optimizador y bot a usar solo model-router.
# Mantiene activos los validadores deterministas, memoria, extractor y compilacion.
AULATEX_MODEL_ROUTER_ONLY=1
AULATEX_LLM_ENGINE="Auto (model-router)"
AULATEX_LLM_PROVIDER=model-router
LLM_PROVIDER=model-router
TB_BOOKS_LLM_REVIEW_ENGINE="Auto (model-router)"

# Claude Foundry
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_CHAT_DEPLOYMENT=claude-opus-4-8
ANTHROPIC_FOUNDRY_API_VERSION=2023-06-01

# Azure OpenAI GPT-5.6-SOL
AZURE_OPENAI_GPT_5_6_SOL_BASE_URL=
AZURE_OPENAI_GPT_5_6_SOL_API_KEY=
AZURE_OPENAI_GPT_5_6_SOL_CHAT_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_GPT_5_6_SOL_API_VERSION="2026-07-09"

# Azure OpenAI GPT-5.6-Luna
AZURE_OPENAI_GPT_5_6_LUNA_BASE_URL=
AZURE_OPENAI_GPT_5_6_LUNA_API_KEY=
AZURE_OPENAI_GPT_5_6_LUNA_CHAT_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_GPT_5_6_LUNA_API_VERSION="2026-07-09"

# Azure OpenAI GPT-5.6-terra
AZURE_OPENAI_GPT_5_6_TERRA_BASE_URL=
AZURE_OPENAI_GPT_5_6_TERRA_API_KEY=
AZURE_OPENAI_GPT_5_6_TERRA_CHAT_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_GPT_5_6_TERRA_API_VERSION="2026-07-09"


# Auto (model-router)
MODEL_ROUTER_BASE_URL=
MODEL_ROUTER_API_KEY=
MODEL_ROUTER_CHAT_DEPLOYMENT=model-router
MODEL_ROUTER_API_VERSION="2025-11-18"

# GPT-Pro
GPT_PRO_BASE_URL=
GPT_PRO_API_KEY=
GPT_PRO_CHAT_DEPLOYMENT=gpt-5.4-pro
GPT_PRO_API_VERSION="2026-03-05"

# Codex
CODEX_BASE_URL=
CODEX_API_KEY=
CODEX_CHAT_DEPLOYMENT=gpt-5.3-codex
CODEX_API_VERSION="2026-02-24"

# DeepSeek-V4-Pro
DEEPSEEK_V4_PRO_BASE_URL=
DEEPSEEK_V4_PRO_API_KEY=
DEEPSEEK_V4_PRO_CHAT_DEPLOYMENT="DeepSeek-V4-Pro"

# GPT-Chat-Latest
GPT_CHAT_LATEST_BASE_URL=
GPT_CHAT_LATEST_API_KEY=
GPT_CHAT_LATEST_CHAT_DEPLOYMENT="gpt-chat-latest"
GPT_CHAT_LATEST_API_VERSION="2026-03-05"

# Mistral-Large-3
MISTRAL_LARGE_3_BASE_URL=
MISTRAL_LARGE_3_API_KEY=
MISTRAL_LARGE_3_CHAT_DEPLOYMENT="Mistral-Large-3"

# Manejo de limites teoricos.
# No fija topes operativos rigidos; solo permite que AulaTeX recorte salidas que excedan el limite teorico del deployment.
AULATEX_ENFORCE_THEORETICAL_LIMITS=1

# --- Bot de Telegram @aulatex_bot (interfaz absorbida) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=aulatex_bot

# --- Imagenes / Video (gpt-image / sora) ---
AZURE_OPENAI_IMAGES_ENDPOINT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_VIDEO_ENDPOINT=
AZURE_OPENAI_VIDEO_DEPLOYMENT=sora-2
AZURE_OPENAI_VIDEO_API_KEY=
AZURE_OPENAI_VIDEO_MAX_SECONDS=8

# --- Hub de Capacidades: percepcion (OCR) + LLMs extra + compartidas ---
AZURE_AI_HOST=
AZURE_AI_API_KEY=
ANTHROPIC_SONNET_DEPLOYMENT=claude-sonnet-4-6
ANTHROPIC_HAIKU_DEPLOYMENT=claude-haiku-4-5
AZURE_OPENAI_OCR_DEPLOYMENT=mistral-ocr-4-0
AZURE_OPENAI_MEDIUM_DEPLOYMENT=mistral-medium-3-5
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/

AZURE_OPENAI_OCR_ENDPOINT_MISTRAL=
