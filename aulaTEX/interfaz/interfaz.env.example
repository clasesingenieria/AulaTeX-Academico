# Copia este archivo a notas.env y completa los valores locales.

# Telegram
TELEGRAM_BOT_TOKEN=

# Azure Speech / transcripcion
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=es-MX
TRANSCRIPTION_PROVIDER=auto

# LLM seleccionable para analisis/generacion base:
# azure-openai, codex, gpt-pro, model-router/auto, claude-foundry
# Los derivados automaticos usan proveedor por accion: explain=claude-foundry,
# suggest=gpt-pro, research=codex, dialectic=model-router.
LLM_PROVIDER=model-router

# Azure OpenAI legacy/fallback
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_AUDIO_MODEL=
AZURE_OPENAI_REALTIME_ENDPOINT=
AZURE_OPENAI_REALTIME_DEPLOYMENT_NAME=
AZURE_OPENAI_REALTIME_API_KEY=
AZURE_OPENAI_REALTIME_TRANSCRIPTION_MODEL=

# Auto / model-router
MODEL_ROUTER_BASE_URL=
MODEL_ROUTER_API_KEY=
MODEL_ROUTER_CHAT_DEPLOYMENT=model-router
MODEL_ROUTER_API_VERSION=2025-11-18

# GPT-Pro
GPT_PRO_BASE_URL=
GPT_PRO_API_KEY=
GPT_PRO_CHAT_DEPLOYMENT=
GPT_PRO_API_VERSION=2026-03-05

# Codex
CODEX_BASE_URL=
CODEX_API_KEY=
CODEX_CHAT_DEPLOYMENT=
CODEX_API_VERSION=2026-02-24

# Claude Foundry / Anthropic Messages API
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_CHAT_DEPLOYMENT=
ANTHROPIC_FOUNDRY_API_VERSION=2023-06-01

# Rutas locales
NOTES_OUTPUT_DIR=data/notes
AUDIO_STORAGE_DIR=data/audio

# Audio de respuesta
TELEGRAM_REPLY_AUDIO_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
POLLY_VOICE_ID=
POLLY_ENGINE=
POLLY_LANGUAGE_CODE=
POLLY_SAMPLE_RATE=
POLLY_TTS_WORKERS=12
VOICE_RATE=
VOICE_VOLUME=

# Azure / despliegue opcional
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_ENV_NAME=
AZURE_LOCATION=
AZURE_SUBSCRIPTION_ID=
